# ===== General =====
APP_PORT=4070
APP_HOST=127.0.0.1
APP_DATA_DIR=./data
APP_PUBLIC_BASE_URL=http://localhost:4070
# Docker Compose overrides APP_HOST=0.0.0.0 and APP_DATA_DIR=/app/data.
# See docs/docker.md. Do not put host filesystem paths in EXO_CERTIFICATE_PATH
# when the app runs inside the container.

# ===== Microsoft Entra app (Graph) =====
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ===== Exchange Online PowerShell (certificate-based app-only auth) =====
EXO_APP_ID=
EXO_TENANT_DOMAIN=example.onmicrosoft.com
EXO_CERTIFICATE_THUMBPRINT=
EXO_CERTIFICATE_PATH=
# Host example: /var/projects/opensignature365/certs/opensignature365-exchange.pfx
# Container example (required when running via Compose): /app/certs/opensignature365-exchange.pfx
EXO_CERTIFICATE_PASSWORD=
EXO_POWERSHELL_BIN=pwsh

# ===== Preview email sender =====
PREVIEW_SENDER_UPN=admin@example.com

# ===== Deployment safety =====
ALLOW_PRODUCTION_DEPLOY=false
DEFAULT_DRY_RUN=true
OPENSIGNATURE_RULE_PREFIX=OpenSignature365

# ===== Asset validation =====
REQUIRE_PUBLIC_IMAGE_URLS=true

# ===== Logging =====
LOG_LEVEL=info
