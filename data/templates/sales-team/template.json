{
  "id": "sales-team",
  "name": "Sales Team",
  "description": "Sales-oriented signature with call-to-action and meeting link.",
  "category": "sales",
  "html": "<table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-family:'Helvetica Neue',Arial,sans-serif;font-size:13px;color:#222;\">\n  <tr><td><strong style=\"font-size:15px;color:#111;\">{{displayName}}</strong></td></tr>\n  <tr><td style=\"color:#555;padding-bottom:6px;\">{{jobTitle}} · {{companyName}}</td></tr>\n  <tr><td>📞 {{mobilePhone | fallback:\"—\"}} · ✉️ <a href=\"mailto:{{mail}}\" style=\"color:#0a66c2;\">{{mail}}</a></td></tr>\n  <tr><td style=\"padding-top:8px;\">\n    <a href=\"https://example.com/book\" style=\"background:#0a66c2;color:#ffffff;padding:6px 12px;border-radius:3px;text-decoration:none;display:inline-block;\">📅 Book a meeting</a>\n  </td></tr>\n</table>",
  "text": "{{displayName}} | {{jobTitle}}\n{{companyName}} · {{mail}}\nBook a meeting: https://example.com/book",
  "required_tags": [
    "displayName",
    "jobTitle",
    "mail",
    "companyName"
  ],
  "optional_tags": [
    "mobilePhone"
  ],
  "assets": []
}